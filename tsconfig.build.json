{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["backend/src/**/*.ts", "shared/**/*.ts"],
  "exclude": ["**/*.test.ts", "frontend", "dist", "node_modules"]
}
