{
  "name": "pinalove-review",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:backend": "tsx watch backend/src/index.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config frontend/vite.config.ts",
    "start": "node dist/backend/src/index.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p frontend/tsconfig.json --noEmit && tsc -p reader/tsconfig.json --noEmit",
    "lint": "oxlint backend shared frontend scripts reader",
    "test": "tsx --test shared/scoring.test.ts shared/classify.test.ts shared/localEnrichment.test.ts shared/workflow.test.ts shared/browseImport.test.ts backend/src/app.test.ts reader/src/reader.test.ts",
    "validate:k8s": "bash scripts/validate-k8s-storage.sh",
    "preview": "vite preview --config frontend/vite.config.ts",
    "reader:login": "tsx reader/src/login.ts",
    "reader:matches": "tsx reader/src/probe-matches.ts",
    "reader:browse": "tsx reader/src/probe-browse.ts",
    "reader:ingest": "tsx reader/src/ingest-matches.ts",
    "reader:profilenew": "tsx reader/src/probe-profilenew.ts",
    "enrich:local": "tsx scripts/enrich-local.ts",
    "workflow:local": "tsx scripts/apply-workflow.ts",
    "import:browse-deck": "tsx scripts/import-browse-deck.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "playwright": "^1.55.1"
  }
}
